{
  "name": "autonomous-cfo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=mocked",
    "test:e2e:live": "playwright test --project=live",
    "test:e2e:ui": "playwright test --project=mocked --ui",
    "build:image": "tsc --noEmit -p tsconfig.build.json && vite build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "^5.7.2",
    "vite": "6.0.6"
  }
}
